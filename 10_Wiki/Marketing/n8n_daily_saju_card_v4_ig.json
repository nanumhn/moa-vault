    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v19.0/me?fields=id,username&access_token=PASTE_YOUR_IG_ACCESS_TOKEN",
        "options": {}
      },
      "id": "c3d4e5f6-0006-4000-8000-000000000006",
      "name": "Get IG User ID",
