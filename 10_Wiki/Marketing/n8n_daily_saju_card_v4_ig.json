    {
      "parameters": {
        "jsCode": "const d = $json;\nconst hashtags = '#ksaju #ksajume #saju #koreanastrology #fourpillars #easternastrology #dailysaju #kpop #spirituality #astrology #selfcare';\nconst imageUrl = d.cardUrl + '&d=' + d.date;\nconst head = '🔮 Today’s Korean Saju: ' + d.keyword;\nconst captionBody = d.pillarHanja + ' · ' + d.romanPillar + '\n\n' + d.body + '\n\n🔗 Free daily card → link in bio\nyour daily saju · k-saju.me\n\n' + hashtags;\nconst caption = head + '\n' + captionBody;\nreturn [{ json: { ...d, imageUrl, hashtags, caption, captionBody } }];"
      },
      "id": "c3d4e5f6-0004-4000-8000-000000000004",
      "name": "Build Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://discord.com/api/webhooks/PASTE_YOUR_WEBHOOK_ID/PASTE_YOUR_WEBHOOK_TOKEN",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: '🔮 Today’s Saju card — ready to post (caption below):', embeds: [ { title: 'Today’s Korean Saju: ' + $json.keyword, description: $json.captionBody, url: 'https://k-saju.me', color: 10705385, image: { url: $json.imageUrl } } ] }) }}",
        "options": {}
      },
      "id": "c3d4e5f6-0005-4000-8000-000000000005",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
